# Repo-wide build parameters. Per-image settings (name, base image, variant,
# description) live in images.json.

# GitHub user/organisation that owns the repo. CI overrides this with
# GITHUB_REPOSITORY_OWNER; "localhost" means a local-only test build
# (no signing policy, no registry ref in the ISO).
REPO_ORGANIZATION="localhost"
REPO_NAME="ublue-custom-image"

IMAGE_KEYWORDS="bootc,oci,linux,bazzite,swayfx,plasma-bigscreen"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
